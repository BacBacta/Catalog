node_modules/
dist/
.astro/
.output/
generated/
*.tsbuildinfo
.env
.env.*
!.env.example
# Aucun journal ne rentre dans le dépôt. Le relevé du capteur de webhook
# (campay-webhooks.log) contient des charges utiles réelles et, le cas
# échéant, des en-têtes de signature — mais la règle vaut pour tous.
*.log
coverage/
playwright-report/
test-results/
.DS_Store
apps/shop/src/data/
apps/shop/.lighthouseci/
apps/api/coverage/

# Artefact de construction, produit dans dist/ par scripts/entetes.mjs.
# Il dependait de PUBLIC_API_BASE et du catalogue seme : le versionner rendait
# la garde CI impossible a satisfaire. Voir le commentaire du script.
# NB : `apps/seller/public/vercel.json` est l'inverse — un fichier SOURCE,
# versionne : son contenu ne depend d'aucun artefact de build.
apps/shop/vercel.json

# Liaison locale du CLI Vercel (identifiants de projet) — jamais versionnee.
.vercel/

# Copie temporaire du CA du proxy sandbox, posee dans le contexte de build le
# temps d'un `docker build` local (runbook deploiement, « bâtisseur refusé »).
# La chaine de deploiement la supprime elle-meme ; elle ne se committe jamais.
.ca-proxy-local.crt
ca-proxy.crt

# Le Dockerfile derive du meme contournement : `apps/api/Dockerfile` plus le CA
# du mandataire, injecte dans le SEUL etage de construction. Il se regenere a
# chaque deploiement et depend de l'environnement qui le fabrique — le
# committer figerait dans le depot une particularite de bac a sable.
Dockerfile.deploiement

# Bundle CA du mandataire de session — jamais destine au depot (public,
# 154 certificats, aucune cle privee), mais il n' a rien a y faire.
.ccr-ca-bundle.crt
