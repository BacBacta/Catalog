{
  "name": "catalog",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:generate": "pnpm --filter @catalog/db generate",
    "db:validate": "pnpm --filter @catalog/db validate",
    "size": "pnpm --filter @catalog/shop size",
    "db:migrate": "pnpm --filter @catalog/db migrate:deploy",
    "db:seed": "pnpm --filter @catalog/db seed",
    "db:constraints": "pnpm --filter @catalog/db constraints",
    "db:reset": "pnpm --filter @catalog/db db:reset"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
