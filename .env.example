# --- base ---
DATABASE_URL="postgresql://catalog:catalog@localhost:5432/catalog?schema=public"

# --- auth ---
BETTER_AUTH_SECRET="change-me-32-chars-minimum-please!"
BETTER_AUTH_URL="http://localhost:8787"

# Origines du NAVIGATEUR autorisees, separees par des virgules. L'app vendeuse
# est servie par Vite, qui renvoie /api vers l'API : le navigateur envoie donc
# l'origine de l'app, pas celle de l'API. Sans cette liste, Better Auth refuse.
TRUSTED_ORIGINS="http://127.0.0.1:5173,http://localhost:5173"

# Cle du HMAC qui protege les codes OTP de reversement en base. A defaut,
# BETTER_AUTH_SECRET est utilise. Il n'y a PAS de valeur de repli codee : un
# secret par defaut serait le meme partout, donc public.
PAYOUT_OTP_SECRET=""

# --- limitation de debit des OTP ---
# Ces plafonds sont de la CONFIGURATION, pas des constantes de code. La limite
# par adresse merite une attention particuliere : la traduction d'adresses des
# operateurs mobiles et les points d'acces partages font que plusieurs vendeuses
# sortent regulierement par la MEME adresse publique. La bonne valeur se regle
# avec des donnees de terrain, sans redeploiement. Une valeur invalide est
# ignoree au profit du defaut — une faute de frappe n'ouvre pas la vanne.
# OTP_MAX_PAR_NUMERO="3"
# OTP_FENETRE_NUMERO_MS="900000"
# OTP_MAX_PAR_IP="12"
# OTP_FENETRE_IP_MS="3600000"
# OTP_MAX_PAR_NUMERO_PAR_JOUR="10"
# OTP_MAX_GLOBAL_PAR_JOUR="2000"

# --- stockage images ---
# Compatible S3, R2 et MinIO. `docker-compose.yml` fournit MinIO en local.
#
# SANS ces quatre variables, l'API prend un stockage EN MEMOIRE, qui refuse de se
# construire si NODE_ENV=production : un oubli de configuration devient une panne
# immediate et lisible plutot qu'une perte de photos differee.
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="catalog-media"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
# R2 ignore la region mais l'exige dans la signature. Vide = « auto ».
S3_REGION=""

# --- agregateur de paiement : EN DORMANCE (ADR 0009) ---
# La v1 se passe d'agregateur. Le paiement est un depot direct et la preuve
# vient du SMS de l'operateur. Rien de cette section n'est utilise par la v1.
#
# Drapeau de reveil : ABSENT par defaut, et sa lecture ECHOUE en production.
# Ne le posez qu'en developpement, pour rejouer la sonde du bac a sable.
# PAYMENT_AGGREGATOR_ENABLED="true"

PAYMENT_PROVIDER="mock"          # mock | campay — sans effet tant que le drapeau est absent

# CamPay — noms alignes sur le tableau de bord (section APP KEYS)
CAMPAY_ENV="DEV"                 # DEV = demo.campay.net, PROD = www.campay.net
CAMPAY_TOKEN=""                  # « Jeton d'acces permanent »
CAMPAY_APP_USERNAME=""           # « Nom d'utilisateur de l'application »
CAMPAY_APP_PASSWORD=""           # « Mot de passe de l'application »
CAMPAY_WEBHOOK_KEY=""            # « Cle webhook de l'application » — secret de signature

# Sonde et capteur (apps/api/scripts/) — jamais en production
CAMPAY_TEST_MSISDN=""            # 237XXXXXXXXX
CAMPAY_TEST_AMOUNT="5"

# ATTENTION : ne jamais committer de valeurs reelles ici. Ce fichier est un
# gabarit. Les secrets vivent dans .env, qui est ignore par git.

# --- envoi du code de connexion (canal sortant) ---
#
# C'EST LE LOGIN, PAS UN GARDE-FOU. Catalog n'a ni mot de passe ni e-mail : ce
# code est la seule chose qui prouve qu'une vendeuse est bien elle. Sans canal
# configuré, aucune vendeuse n'entre — et `console` REFUSE de se charger en
# production, donc l'API ne démarre même pas. C'est voulu : un fournisseur
# factice actif en production, ce sont des OTP que personne ne reçoit.
#
# Cinq valeurs :
#   console   → écrit sur la sortie standard. Développement seulement.
#   orange    → SMS, API « SMS Cameroon » (sms-cm), TOUS OPÉRATEURS.
#   mboasms   → SMS, passerelle locale. MTN, Orange et Camtel. Voir l'ADR 0026.
#   whatsapp  → modèle d'authentification WhatsApp. Porte UNIQUEMENT les deux OTP.
#   provider  → lève. La place tenue pour une autre passerelle.
SMS_PROVIDER="console"

# --- mboasms : passerelle camerounaise, MTN + Orange + Camtel ---
#
# Voir l'ADR 0026. Retenue parce qu'elle annonce la livraison directe vers les
# TROIS réseaux par une seule intégration, en paiement à l'usage — donc sans le
# forfait prépayé dont l'état est resté incompréhensible chez Orange.
#
# La clé se génère dans le compte, section « API Key ». Elle n'est affichée
# QU'UNE FOIS à la création.
MBOA_API_KEY=""                   # format mboa_xxxxxxxxxxxxxxxxxxxx
#
# Identifiant d'expéditeur. Facultatif : à défaut, la passerelle utilise celui
# du compte — S'IL EST CONFIGURÉ. Mesuré le 01/08/2026 : sans defaut configure,
# l'envoi echoue proprement (`success: false`, « Sender ID is required »,
# credit non consomme).
#
# LE BLOCAGE N'EST PAS CHEZ MBOASMS. « Sans Sender ID valide, vos messages sont
# automatiquement bloqués par le réseau de l'opérateur — pas par MboaSMS » (leur
# page publique). C'est la MEME liste blanche que celle qu'Orange exigeait —
# mais la passerelle la soumet AUX TROIS OPERATEURS D'UN COUP, gratuitement,
# avec un delai annonce de 24 a 72 h. C'est precisement le service qui a fait
# retenir un agregateur (ADR 0026).
#
# Le parcours : tableau de bord > section « Sender ID » > nom de 3 a 11
# caracteres, lettres et chiffres (« CATALOG » convient) > soumission. La
# gestion n'est PAS exposee a la cle API (403 sur les chemins de senders,
# mesure) : le statut se lit sur mboasms.com/sender-id, connecte.
MBOA_SENDER_ID=""
# MBOA_BASE_URL=""                # bac à sable uniquement ; jamais en production
#
# CE QU'ON NE SAURA PAS, et il faut le savoir avant d'ouvrir : la documentation
# n'expose NI rappel de livraison, NI rapport de remise. L'adaptateur exige
# `success: true` et au moins un destinataire retenu — c'est plus que ce que
# donne Orange —, mais une acceptation ne prouve toujours pas une réception.
# Le seul verdict reste un téléphone qui sonne.

# --- orange : API « SMS Cameroon » (sms-cm) ---
#
# ATTENTION AU JUMEAU. Orange publie aussi `sms-onnet-cm`, « SMS Cameroon
# (Orange Only) », qui ne délivre QU'AUX abonnés Orange. Les deux offres
# partagent le MÊME chemin technique : il y a donc deux façons de se retrouver
# en « Orange seulement », et le code n'en couvre qu'une.
#
#   1. le paramètre `resource_type_parameter_management=SMS_OCB2` — l'adaptateur
#      ne le pose jamais, un test l'interdit ;
#   2. LA SOUSCRIPTION DE L'APPLICATION, choisie dans la console. Ces
#      identifiants doivent venir d'une application souscrite à `sms-cm`.
#      Le code ne peut ni le voir ni le contraindre.
#
# Si le point 2 est raté, aucune vendeuse MTN ne reçoit son code — et rien ne le
# signale : l'API répond normalement. Vérifiez-le par une MESURE, un envoi vers
# un numéro MTN, avant d'ouvrir.
#
#   node docs/terrain/orange-sms-contrat.mjs
#     → lit les contrats de l'application. Sans rien envoyer.
#   node docs/terrain/orange-sms-contrat.mjs --depuis +237… --vers <numéro MTN>
#     → l'envoi réel, seule mesure qui tranche. « Accepté » n'est pas « reçu » :
#       une acceptation suivie d'une non-réception EST la signature d'onnet.
#
# Identifiants de l'application, console Orange Developer.
# → Souscrire à « SMS Cameroon » : /myapps/new/addapi/sms-cm
ORANGE_CLIENT_ID=""
ORANGE_CLIENT_SECRET=""
# CE N'EST PAS VOTRE NUMÉRO. C'est un identifiant de ROUTAGE fixe, publié par
# Orange par pays sous le nom `country_sender_number`. Quatre chiffres après
# l'indicatif : ce n'est pas un MSISDN. Il va dans l'URL ET dans le corps.
#
#   Cameroun CMR  tel:+2370000        Côte d'Ivoire CIV  tel:+2250000
#   Sénégal  SEN  tel:+2210000        Mali          MLI  tel:+2230000
#   → table complète : https://developer.orange.com/apis/sms/getting-started
#
# Le nom affiché à la destinataire, lui, vient d'ORANGE_SENDER_NAME.
#
# MESURE DU 01/08/2026 — Orange NE VALIDE PAS ce champ, parce qu'il route sur
# autre chose. Un envoi depuis `tel:+237000000000`, format camerounais invalide,
# a reçu HTTP 201 Created. Une mauvaise valeur échoue donc en SILENCE : 201 en
# réponse, journaux propres, et la vendeuse ne reçoit rien. Le garde de
# `sms-orange.ts` est la seule barrière — il n'y en a aucune côté opérateur.
#
# À CONFIRMER PAR UN ENVOI RÉEL : la valeur ci-dessous vient de la documentation
# officielle, mais des exemples communautaires utilisent le numéro complet de
# l'expéditeur (`tel:+237698765432`). Aucun code d'erreur ne départagera les
# deux — Orange accepte l'un comme l'autre. Seul un téléphone qui sonne tranche.
ORANGE_SENDER_ADDRESS="+2370000"  # Cameroun. Voir la table ci-dessus.
# Nom d'expéditeur affiché. Il SE DÉCLARE auprès de l'opérateur, il ne s'invente
# pas. Vide = nom généré par défaut, qu'Orange n'accepte plus dans certains pays.
#
# MESURE DU 01/08/2026 — C'EST LA CAUSE DES ENVOIS ACCEPTÉS PUIS JAMAIS REMIS.
# La console d'Orange le dit sur l'écran « Authorized senders » :
#
#   « If the API returns http 201 but the message is not received on the
#     terminal, please contact local team to check sender name whitelisting for
#     your account. For non-Orange numbers, the sender names will have to be
#     whitelisted with the other operators too. »
#
# Ce n'est donc pas la VALEUR qui bloque, c'est son inscription sur liste
# blanche CHEZ CHAQUE OPÉRATEUR. Le nom par défaut lui-même ne suffit pas pour
# joindre un numéro MTN. Aucune valeur écrite ici ne changera quoi que ce soit
# tant que la démarche n'est pas faite auprès de l'équipe locale Orange.
ORANGE_SENDER_NAME=""
# ORANGE_BASE_URL=""              # pour un bac à sable ; jamais en production

# --- accusé de livraison (« Delivery Receipt ») ---
#
# CE N'EST PAS DU CONFORT. C'est le seul contrôle AUTOMATIQUE du fait que les
# vendeuses MTN reçoivent leur code : si les numéros en 67/68 ne sont jamais
# livrés alors que ceux en 69 le sont toujours, l'application est souscrite à la
# mauvaise offre Orange. Aucun test du dépôt ne peut le voir.
#
# Orange NE SIGNE PAS ses rappels — ni en-tête d'authentification, ni empreinte.
# Le secret est donc dans le CHEMIN, comme le lien de suivi de l'acheteuse.
# Il empêche un tiers de fabriquer de fausses mesures ; il ne protège ni d'une
# fuite du secret, ni d'un rejeu. C'est proportionné : la route n'écrit rien,
# n'autorise personne, et n'incrémente qu'un compteur.
#
# SANS ce secret, la route n'existe pas du tout — refus par défaut.
# Au moins 32 caractères, tirés au hasard. Jamais de valeur devinable.
# MESURE DU 01/08/2026 — LE `notifyURL` DE LA REQUÊTE NE SUFFIT PAS.
# Orange l'accepte, le renvoie fidèlement dans sa réponse… et ne s'en sert
# jamais si aucun rappel n'est déclaré dans la console développeur. L'écran
# « Callback endpoint configuration » doit porter l'URL complète, secret inclus.
# Tant qu'il affiche « None », AUCUN accusé n'arrivera, et rien ne le signalera.
#
# C'est le même piège que le nom d'expéditeur et que l'adresse d'expéditeur :
# Orange accepte tout au moment de l'appel, et se tait ensuite.
SMS_ACCUSE_SECRET=""
# L'URL complète, secret compris, telle qu'Orange la rappellera.
# Contrainte d'Orange : HTTPS sur le port 443, certificat valide. L'URL doit en
# outre être inscrite sur leur liste blanche, par un formulaire — hors API.
SMS_ACCUSE_URL=""    # ex. https://api.catalog.cm/api/sms/accuse/<le-secret>

# --- whatsapp : modèle d'authentification (Cloud API) ---
#
# Un modèle N'EST PAS une phrase : Meta approuve un gabarit et l'API attend le
# PARAMÈTRE. Le code figure deux fois dans la charge utile — corps et bouton
# « copier le code » —, et les deux doivent porter la même valeur.
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
# Le nom du modèle APPROUVÉ, tel qu'il apparaît dans la console. Ne pas l'inventer.
WHATSAPP_TEMPLATE_OTP=""
# Le code de langue doit correspondre EXACTEMENT au modèle approuvé : un `fr_FR`
# là où Meta a enregistré `fr` fait échouer l'envoi, avec un message qui ne dit
# pas que c'est la langue qui cloche.
WHATSAPP_TEMPLATE_LANGUE="fr"
# WHATSAPP_API_VERSION="v21.0"
# WHATSAPP_BASE_URL=""

# --- connexion par WhatsApp ENTRANT (ADR 0027) ---
#
# Le sens INVERSE du gabarit ci-dessus : la vendeuse ENVOIE un message
# pre-rempli au numero WhatsApp de Catalog, et le webhook Meta livre son
# numero, atteste par Meta. Aucun SMS sortant — donc aucune liste blanche
# d'expediteur a negocier avec les operateurs, le mur sur lequel l'API Orange
# s'est arretee le 01/08/2026. Recevoir n'exige AUCUN gabarit approuve.
#
# Le numero WhatsApp de Catalog, celui du compte WABA. E.164 ou chiffres.
# Absent : le canal est ferme, le bouton n'apparait pas dans l'app vendeuse.
WHATSAPP_WABA_NUMERO=""
# Le secret d'URL du webhook (generer : openssl rand -hex 24). Il sert AUSSI de
# jeton de verification a la poignee de main d'abonnement Meta.
WHATSAPP_ENTRANT_SECRET=""
# L'« App Secret » Meta, console developpeur > Parametres > General. Il signe
# chaque livraison (X-Hub-Signature-256) : SANS LUI LA ROUTE N'EXISTE PAS,
# parce qu'un webhook non signe accepterait des faux messages entrants —
# c'est-a-dire une connexion au compte de n'importe quelle vendeuse.
WHATSAPP_APP_SECRET=""

# --- bot WhatsApp — ADR 0031, EN DORMANCE sans cle ---
#
# Le canal du bot : format Cloud API, servi par 360dialog (sandbox ou
# production). SANS WABOT_API_KEY, RIEN n'est monte : pas d'envoi, et le
# webhook entrant ne route vers le bot aucun message — les defis de connexion
# (ADR 0027) continuent de fonctionner seuls.
#
# Sandbox : envoyer START au numero sandbox 360dialog, la cle arrive en
# reponse. WABOT_BASE_URL="https://waba-sandbox.360dialog.io/v1" — le /v1 est
# MESURE : le sandbox ne sert pas /messages a la racine (404), production si.
# Production : cle du Hub, WABOT_BASE_URL="https://waba-v2.360dialog.io".
# La base n'a pas de defaut : melanger sandbox et production en silence est
# exactement le genre de panne qu'on ne veut pas diagnostiquer un samedi.
WABOT_API_KEY=""
WABOT_BASE_URL=""
# Le TRANSPORT (ADR 0046) : « 360dialog » ou « meta ». Il se DEDUIT de l'hote de
# WABOT_BASE_URL — un hote 360dialog.io ou facebook.com suffit a trancher, et
# les deploiements existants n'ont donc rien a ajouter. Ne le declarer que pour
# un hote inconnu (relais, mandataire).
#
# Il n'est PAS decoratif : les deux chemins different sur trois points.
#   authentification  D360-API-KEY          | Authorization: Bearer
#   envoi             {base}/messages       | {base}/{idNumero}/messages
#   media, 2e temps   hote de l'URL REECRIT | URL suivie TELLE QUELLE
# Declare en contradiction avec l'hote, le service REFUSE de demarrer : une base
# Meta avec une cle 360dialog rend des HTTP 401 qu'on impute a la cle, et on
# passe la soiree dessus.
#
# Meta directe : WABOT_BASE_URL="https://graph.facebook.com/v21.0" et
# WHATSAPP_PHONE_NUMBER_ID renseigne — chez Meta le numero emetteur est un
# segment d'URL. Le numero de TEST Meta (+1 555…) passe par ce chemin : il ne
# s'ajoute pas a l'application WhatsApp Business (aucune ligne derriere), il
# n'ecrit qu'a 5 destinataires inscrits, et il ne deviendra jamais un numero de
# production. Sa valeur est ailleurs : c'est le seul canal a offrir de VRAIS
# medias, donc le seul ou la chaine photo se verifie.
WABOT_TRANSPORT=""
# ⚠️ CORRIGE le 07/08/2026 (ADR 0047). Cette section affirmait que « les
# webhooks relayes par 360dialog NE SONT PAS SIGNES ». C'est FAUX pour le
# relais v2 : il repercute la signature de Meta, calculee avec le secret
# d'application de 360dialog — que nous n'avons pas et n'aurons jamais.
#
# La route accepte donc DEUX preuves, alternatives et chacune suffisante :
# une signature Meta valide, OU cet en-tete partage. Exiger l'absence de
# signature pour honorer l'en-tete ne protegeait de rien — c'est l'appelant
# qui choisit d'en envoyer une — et refusait tout le trafic legitime relaye.
#
# 360dialog rejoue tel quel l'en-tete Authorization configure sur le webhook.
# Le poser des deux cotes en une fois :
#   D360_API_KEY="…" node docs/terrain/webhook-360dialog.mjs poser
# Generer une valeur (openssl rand -hex 24), la poser ICI et dans la
# configuration du webhook chez 360dialog. Comparaison en temps constant.
# En Meta directe (WABA en propre), laisser vide : l'HMAC reprend du service.
WABOT_WEBHOOK_AUTH=""

# Le Flow de livraison — ADR 0055. VIDE PAR DEFAUT, et c'est le cas normal :
# sans lui, la livraison se saisit question par question, comme aujourd'hui.
# Pose, un formulaire « Remplir en une fois » s'AJOUTE a la question — il ne
# la remplace jamais : un Flow ne s'affiche pas sur un WhatsApp ancien, et
# l'Android bas de gamme est notre population, pas un cas limite.
#
# Depuis la bascule en direct chez Meta (ADR 0046), les trois formulaires se
# deposent en une commande — `node apps/api/scripts/flux.mjs --deposer` cree,
# televerse et PUBLIE, puis affiche les trois identifiants a poser ici. La
# publication est l'oubli le plus couteux : un Flow en brouillon s'envoie sans
# erreur et ne s'ouvre jamais.
#
# Les noms de champs des definitions (docs/flux-*.json) sont le CONTRAT avec
# les lecteurs du domaine ; les changer d'un cote casse la lecture EN SILENCE.
# `--voir` verifie ce contrat hors ligne.
WABOT_FLUX_LIVRAISON_ID=""

# Le Flow d'INSCRIPTION vendeuse — ADR 0063. Nom de boutique, ville, langue.
# Le numero de reversement n'y est PAS : il exige son propre OTP, envoye au
# NOUVEAU numero, et un formulaire statique ne peut pas le verifier. L'y mettre
# donnerait l'illusion d'une saisie faite sur le champ le plus sensible du
# produit.
WABOT_FLUX_INSCRIPTION_ID=""

# --- la boutique web mene au bot (ADR 0066) ---
#
# Le numero du BOT, pour le bouton « Commander » de la fiche produit. VIDE PAR
# DEFAUT : sans lui, la page garde exactement le chemin d'avant — un bouton
# vers wa.me/ sans numero ouvrirait WhatsApp sur rien.
#
# C'est une variable de CONSTRUCTION de la boutique (prefixe PUBLIC_), pas un
# secret : ce numero est affiche partout, sur la carte-vitrine comme sur les
# liens partages.
PUBLIC_BOT_WHATSAPP=""

# --- reconstruction de la boutique publique (ADR 0065) ---
#
# VIDE PAR DEFAUT, et c'est le cas normal en developpement : sans crochet,
# aucun deploiement n'est demande, et le fil n'annonce AUCUN delai — annoncer
# une mise en ligne qui n'arrivera pas serait pire que le silence.
#
# La boutique publique lit un instantane JSON pris a la CONSTRUCTION et ne
# parle jamais a la base (lot 6) : c'est ce qui tient les 30 Ko de JS. Le prix
# de ce choix a ete mesure le 11/08/2026 — deux boutiques nees dans le fil
# repondaient 404, avec articles, carte-vitrine et commandes.
#
# ── DEUX transports, et c'est le second qui marche — ADR 0068 ──────────────
#
# 1. `repository_dispatch` GitHub, qui reveille `.github/workflows/
#    deploiement.yml`. C'est le transport RETENU. Le workflow refait
#    l'instantane depuis la base, reconstruit et deploie `apps/shop/dist` —
#    donc `dist/` reste la racine deployee, et la politique de securite comme
#    les reecritures `/v/*` continuent de s'appliquer (ADR 0067).
#
# 2. Un CROCHET de deploiement de l'hebergeur. C'etait le choix d'origine, et
#    il ne peut pas fonctionner ici : mesure du 11/08/2026, le projet Vercel de
#    la boutique n'est relie a aucun depot, et un crochet suppose un projet
#    relie. Il reste en repli pour le jour ou ce serait le cas.
#
# Les deux jeux poses, le dispatch l'emporte. A moitie pose — jeton sans depot,
# ou l'inverse —, RIEN n'est monte : on ne veut pas croire la reconstruction
# branchee alors qu'elle ne part nulle part.
#
# Le jeton et l'URL valent un droit de deployer : ce sont des SECRETS, ils ne
# figurent dans aucune trace. Le depot, lui, n'en est pas un.
#
# Le jeton GitHub demande une seule permission : `contents: write` sur ce
# depot, la portee minimale que `repository_dispatch` exige. Le dispatch ne
# fonctionne que depuis la branche par defaut.
SHOP_REBUILD_GITHUB_REPO=""
SHOP_REBUILD_GITHUB_TOKEN=""
# `preproduction` (defaut) ou `production` — l'environnement GitHub, donc le
# projet Vercel vise. Absente, on ne touche pas la production.
SHOP_REBUILD_ENVIRONNEMENT=""
SHOP_REBUILD_HOOK_URL=""

# Le Flow d'AVIS — ADR 0063. La note ET le mot en une fois, la ou le chemin
# question-par-question les separe. Il s'AJOUTE a la liste d'etoiles, il ne la
# remplace pas.
WABOT_FLUX_AVIS_ID=""

# Le banc d'essai — ADR 0058. VIDE PAR DEFAUT, et la production ne la pose
# JAMAIS : chaque numero liste ici, hors Cameroun, peut se connecter a
# l'espace vendeuse et servir de numero de reversement, et ses codes partent
# par le WhatsApp du bot au lieu du SMS Orange. C'est ce qui rend le parcours
# paiement JOUABLE depuis l'Europe sur le banc — et strictement rien d'autre :
# sans la variable, la regle +237 est exactement celle d'avant.
BANC_ESSAI_NUMEROS_HORS_CM=""

# --- passkeys (WebAuthn) — ADR 0028, EN DORMANCE jusqu'au domaine definitif ---
#
# NE POSEZ CES VARIABLES QUE SUR LE DOMAINE FINAL. Le rpId est epingle au
# domaine de l'app vendeuse : une cle enrolee sous un domaine MEURT avec lui.
# Et fly.dev comme vercel.app sont sur la Public Suffix List — on ne peut pas
# y poser de rpId parent. Enroler des vendeuses en preproduction leur
# promettrait une reconnexion douloureuse a la migration.
#
# Absentes : le plugin n'est pas monte, ses points d'entree repondent 404, et
# l'app vendeuse ne propose rien — elle sonde le serveur avant d'afficher quoi
# que ce soit. La table `passkey` existe des maintenant (migration expand).
#
# Le bon reglage, le jour venu :
#   PASSKEY_RP_ID="catalog.cm"                    # couvre app.* et api.*
#   PASSKEY_ORIGIN="https://app.catalog.cm"       # l'origine de l'app vendeuse
PASSKEY_RP_ID=""
PASSKEY_ORIGIN=""

# --- ceremonie Google (ADR 0029) — la SEULE sans dossier a deposer ---
#
# L'ADR 0029 amende la regle « pas d'e-mail » d'un cran precis : le bouton
# « Continuer avec Google » est permis — selecteur de compte systeme, AUCUNE
# adresse saisie, AUCUN message envoye, jamais. L'adresse Google devient la cle
# technique du compte ; aucun ecran ne la demande.
#
# Configuration en libre-service, console Google Cloud > APIs & Services >
# Credentials > OAuth client ID (type Web) :
#   - origine autorisee : l'URL de l'app vendeuse
#   - URI de redirection : <URL de l'API>/api/auth/callback/google
# Scopes de base (profil) : pas de revue lourde ; l'ecran de consentement
# affiche « application non verifiee » tant que la revue cosmetique n'est pas
# faite.
#
# Absentes : ni fournisseur monte, ni bouton affiche — l'endpoint d'etat des
# ceremonies (`/api/auth/connexion-whatsapp/etat`) repond `google: false`.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- provider : la place tenue, si l'on veut une autre passerelle ---
SMS_API_KEY=""
SMS_SENDER_ID="CATALOG"

# --- preuve par SMS (lot 8) ---
# Cle de chiffrement AU REPOS du SMS brut. Il porte le SOLDE du compte de la
# vendeuse : sans cette cle, il serait stocke en clair. Au moins 32 caracteres,
# aucune valeur de repli — un secret par defaut serait le meme partout.
SMS_ENCRYPTION_KEY=""

# --- rampe de paiement (lot 9) ---
# LES CODES USSD NE SONT PAS DES CONSTANTES DE CODE. Les operateurs les changent,
# et un code fige se remplace par un redeploiement — c'est-a-dire trop tard.
# Les valeurs par defaut vivent dans apps/api/src/domain/ramp/config.ts, seul
# endroit du depot ou un code est ecrit ; les variables ci-dessous les remplacent
# a chaud, sans reconstruire la boutique (l'ecran lit GET /api/rampe).
#
# Une valeur mal formee est IGNOREE au profit du defaut : une faute de frappe ne
# doit pas fabriquer une chaine qui ne compose rien.
#
# Codes d'entree — releves le 29/07/2026 dans la reponse de l'operateur.
# RAMPE_MTN_ENTREE_MODELE="*126#"
# RAMPE_ORANGE_ENTREE_MODELE="#150*50#"
#
# Raccourcis parametres — {numero} et {montant} y sont remplaces. Ils sont
# NON VERIFIES : personne ne les a composes sur un telephone reel a Douala.
# RAMPE_MTN_RACCOURCI_MODELE="*126*1*1*{numero}*{montant}#"
# RAMPE_ORANGE_RACCOURCI_MODELE="#150*50*{numero}*{montant}#"
#
# Le drapeau ne suit PAS le gabarit : le poser est un acte separe, reserve a qui
# a compose la chaine sur un vrai telephone et vu le transfert aboutir.
# RAMPE_MTN_RACCOURCI_VERIFIE="false"
# RAMPE_ORANGE_RACCOURCI_VERIFIE="false"
#
# Minimums operateur — mesures le 29/07/2026 : Orange refuse sous 10 F (ER201).
# RAMPE_MTN_MIN_XAF="5"
# RAMPE_ORANGE_MIN_XAF="10"

# --- boutique publique ---
# Origine de l'API vue par le NAVIGATEUR de l'acheteuse. Vide = meme origine.
# C'est la seule variable de la boutique lue a la construction : elle ne porte
# aucun code USSD, seulement l'adresse ou les lire.
PUBLIC_API_BASE=""

# ─────────────────────────── observabilité (lot 14) ───────────────────────────
# L'observabilité NE DÉMARRE PAS sans cette variable, et c'est voulu : le code
# instrumenté tourne à l'identique quand aucun SDK n'est enregistré, et un
# exportateur qui tente de joindre un collecteur absent ajoute une erreur réseau
# toutes les cinq secondes dans le journal de développement. Un journal qu'on
# apprend à ignorer est un journal perdu. Voir l'ADR 0023.
#
# L'URL est celle de la RACINE du collecteur : les chemins `/v1/traces` et
# `/v1/metrics` sont ajoutés par le code.
OTEL_EXPORTER_OTLP_ENDPOINT=""    # ex. http://collecteur:4318
CATALOG_VERSION=""                # renseigné au déploiement, sert d'attribut de ressource

# ─────────────────────────── sauvegardes (lot 14) ─────────────────────────────
# `BACKUP_DIR` doit être sur un AUTRE disque que la base : une sauvegarde à côté
# de ce qu'elle sauvegarde ne protège que de l'erreur humaine.
BACKUP_DIR="/var/backups/catalog"
BACKUP_RETENTION_DAYS="14"
# La cible d'une restauration. Son nom diffère de DATABASE_URL EXPRÈS : le
# script refuse d'écrire dans la base de production, et un nom distinct rend
# impossible la restauration accidentelle « parce que l'environnement était déjà
# chargé dans le shell ».
TARGET_DATABASE_URL=""

# ═══════════════════════ durcissement et lancement (lot 15) ═══════════════════
# Voir l'ADR 0024 et docs/runbooks/checklist-lancement.md.

# --- CORS et en-têtes ---
# Les origines du NAVIGATEUR autorisées sur les routes sous session (app
# vendeuse). Le joker y est interdit par la spécification elle-même : un
# navigateur refuse `*` avec des identifiants. Les routes publiques — reçu,
# suivi, rampe, statut — restent lisibles par toute origine : ce qui les
# autorise est la clé portée dans l'URL, jamais un cookie.
# Même variable que Better Auth : une seule liste, une seule vérité.
TRUSTED_ORIGINS=""      # ex. https://app.catalog.cm,https://catalog.cm

# HSTS vaut pour un domaine ENTIER et pour deux ans. Ne le poser que depuis un
# environnement dont on sait qu'il est servi en HTTPS : posé par erreur en
# développement, il rend un sous-domaine injoignable sans recours.
HSTS="false"

# --- limitation de débit des routes publiques ---
# Mêmes raisons que les plafonds d'OTP du lot 4 : au Cameroun, la traduction
# d'adresses des opérateurs fait sortir plusieurs acheteuses par une même
# adresse publique. La bonne valeur ne se devine pas depuis un bureau.
# Une valeur non numérique ou négative est IGNORÉE au profit du défaut : une
# faute de frappe ne doit pas ouvrir la vanne.
#
# ATTENTION : le compteur vit dans la mémoire du processus. Avec N instances,
# la limite effective est N fois celle qui est écrite.
# DEBIT_LECTURE_MAX="120"          # /api/recu, /api/suivi, /api/rampe — par minute
# DEBIT_LECTURE_FENETRE_MS="60000"
# DEBIT_ECRITURE_MAX="10"          # contre-signature, contestation, avis
# DEBIT_ECRITURE_FENETRE_MS="60000"
# DEBIT_PREUVE_MAX="30"            # collage de SMS, sous session vendeuse
# DEBIT_PREUVE_FENETRE_MS="60000"

# --- interrupteur d'arrêt ---
# Trois positions : `ouvert`, `lecture_seule`, `ferme`.
# `lecture_seule` est le choix par défaut en cas de doute : les reçus déjà émis
# restent consultables. Un reçu est une preuve opposable — le faire disparaître
# en même temps qu'on coupe les écritures transformerait un incident technique
# en incident de confiance.
# Une valeur INCONNUE laisse le service ouvert, délibérément : une faute de
# frappe ne doit pas arrêter Catalog. L'arrêt est un acte délibéré.
INTERRUPTEUR="ouvert"
#
# Le fichier gagne sur la variable, et c'est ce qui fait de l'interrupteur un
# vrai interrupteur : `echo lecture_seule > /run/catalog/interrupteur` bascule
# en deux secondes, sans redémarrage et sans déploiement — c'est-à-dire les
# jours où l'on n'est sûr ni des minutes ni de la chaîne d'outils.
# Un fichier absent ou illisible n'est pas une erreur : la variable fait foi.
INTERRUPTEUR_FICHIER=""    # ex. /run/catalog/interrupteur

# Message d'incident affiché sur la page publique /statut. Vide = aucun.
# N'y jamais écrire d'heure de reprise qu'on n'est pas sûr de tenir : une heure
# ratée coûte plus cher que pas d'heure du tout.
STATUT_MESSAGE=""

# --- ouverture progressive ---
# Part des vendeuses autorisées à ÉCRIRE, de 0 à 100. Absent vaut 100 : le
# mécanisme est inerte tant que personne ne l'arme.
# La cohorte est calculée par hachage de l'identifiant, donc MONOTONE : élargir
# n'exclut jamais quelqu'un qui était dedans. Réduire, en revanche, exclut —
# pour arrêter, utiliser l'interrupteur, qui est franc et lisible.
# Aucune LECTURE n'est jamais bloquée, et le parcours acheteuse n'est jamais
# filtré.
COHORTE_POURCENT="100"
# Identifiants de vendeuses admises quel que soit le pourcentage — les pilotes
# du test de terrain, dont on ne veut pas dépendre d'un hachage.
COHORTE_PILOTES=""

# --- test de charge (scripts/charge/charge.mjs) ---
# La cible est une HYPOTHÈSE, pas une mesure : le calcul du pic du 8 mars est
# écrit entrée par entrée en tête du script, avec le statut de chacune.
# CHARGE_BASE="http://127.0.0.1:8787"
# CHARGE_RPS=""            # défaut : la cible modélisée (3× le pic supposé)
# CHARGE_DUREE="20"
# CHARGE_CODES=""          # codes de vérification réels, séparés par des virgules
# CHARGE_JETONS=""         # jetons de suivi réels — sinon la mesure porte sur
#                          # des clés inexistantes, et le script le dit
