{
  "name": "@catalog/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "generate": "prisma generate",
    "validate": "prisma validate",
    "format": "prisma format",
    "migrate": "prisma migrate dev",
    "constraints": "node scripts/apply-constraints.mjs",
    "test": "TZ=Africa/Douala vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "echo ok",
    "check:offline": "node scripts/check-schema.mjs",
    "seed": "node --experimental-strip-types prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "migrate:deploy": "prisma migrate deploy && node scripts/apply-constraints.mjs"
  },
  "dependencies": {
    "@catalog/contracts": "workspace:*",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "prisma": "7.9.1",
    "vitest": "4.1.10",
    "typescript": "6.0.3",
    "@types/node": "26.1.2"
  }
}
