{
  "version": "7.3",
  "screens": [
    {
      "id": "ARTICLE",
      "title": "Nouvel article",
      "terminal": true,
      "data": {},
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextSubheading",
            "text": "Nom, prix, stock — et l'article est en ligne."
          },
          {
            "type": "Form",
            "name": "formulaire",
            "children": [
              {
                "type": "TextInput",
                "name": "nom",
                "label": "Nom de l'article",
                "required": true,
                "input-type": "text",
                "helper-text": "Exemple : Pagne wax 6 yards"
              },
              {
                "type": "TextInput",
                "name": "prix",
                "label": "Prix, en francs",
                "required": true,
                "input-type": "number",
                "helper-text": "Exemple : 15000"
              },
              {
                "type": "TextInput",
                "name": "stock",
                "label": "Quantité disponible (facultatif)",
                "required": false,
                "input-type": "number",
                "helper-text": "Il ne se décompte pas tout seul — vous le corrigez à la main."
              },
              {
                "type": "PhotoPicker",
                "name": "photo",
                "label": "Photo de l'article (facultatif)",
                "description": "Appareil photo ou galerie — une seule suffit.",
                "photo-source": "camera_gallery",
                "min-uploaded-photos": 0,
                "max-uploaded-photos": 1
              },
              {
                "type": "Footer",
                "label": "Publier l'article",
                "on-click-action": {
                  "name": "complete",
                  "payload": {
                    "nom": "${form.nom}",
                    "prix": "${form.prix}",
                    "stock": "${form.stock}",
                    "photo": "${form.photo}"
                  }
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
