{
  "version": "7.3",
  "screens": [
    {
      "id": "BOUTIQUE",
      "title": "Votre boutique",
      "data": {},
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextSubheading",
            "text": "Deux réponses, puis votre premier article."
          },
          {
            "type": "Form",
            "name": "formulaire",
            "children": [
              {
                "type": "TextInput",
                "name": "boutique",
                "label": "Nom de votre boutique",
                "required": true,
                "input-type": "text",
                "helper-text": "Exemple : Chez Amina"
              },
              {
                "type": "TextInput",
                "name": "ville",
                "label": "Ville où vous vendez",
                "required": true,
                "input-type": "text",
                "helper-text": "Exemple : Douala"
              },
              {
                "type": "RadioButtonsGroup",
                "name": "langue",
                "label": "Langue de vos clientes",
                "required": true,
                "data-source": [
                  { "id": "fr", "title": "Français" },
                  { "id": "en", "title": "English" }
                ]
              },
              {
                "type": "Footer",
                "label": "Continuer",
                "on-click-action": {
                  "name": "navigate",
                  "next": { "type": "screen", "name": "ARTICLE" },
                  "payload": {
                    "boutique": "${form.boutique}",
                    "ville": "${form.ville}",
                    "langue": "${form.langue}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "ARTICLE",
      "title": "Votre premier article",
      "terminal": true,
      "data": {
        "boutique": { "type": "string", "__example__": "Chez Amina" },
        "ville": { "type": "string", "__example__": "Douala" },
        "langue": { "type": "string", "__example__": "fr" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextSubheading",
            "text": "Ce que vous vendez — vous pourrez en ajouter d'autres après."
          },
          {
            "type": "Form",
            "name": "formulaire",
            "children": [
              {
                "type": "TextInput",
                "name": "nom",
                "label": "Nom de l'article",
                "required": false,
                "input-type": "text",
                "helper-text": "Exemple : Pagne wax 6 yards"
              },
              {
                "type": "TextInput",
                "name": "prix",
                "label": "Prix en francs",
                "required": false,
                "input-type": "number",
                "helper-text": "Exemple : 15000"
              },
              {
                "type": "TextInput",
                "name": "stock",
                "label": "Combien en avez-vous ? (facultatif)",
                "required": false,
                "input-type": "number",
                "helper-text": "Laissez vide si vous ne comptez pas."
              },
              {
                "type": "PhotoPicker",
                "name": "photo",
                "label": "Photo de l'article (facultatif)",
                "description": "Appareil photo ou galerie — une seule suffit.",
                "photo-source": "camera_gallery",
                "min-uploaded-photos": 0,
                "max-uploaded-photos": 1
              },
              {
                "type": "Footer",
                "label": "Ouvrir ma boutique",
                "on-click-action": {
                  "name": "complete",
                  "payload": {
                    "boutique": "${data.boutique}",
                    "ville": "${data.ville}",
                    "langue": "${data.langue}",
                    "nom": "${form.nom}",
                    "prix": "${form.prix}",
                    "stock": "${form.stock}",
                    "photo": "${form.photo}"
                  }
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
