---
import BadgeVerifie from "../../components/BadgeVerifie.astro";
import PhotoArticle from "../../components/PhotoArticle.astro";
import Prix from "../../components/Prix.astro";
import Commander from "../../islands/Commander.tsx";
import Base from "../../layouts/Base.astro";
import {
  type ArticlePublic,
  type BoutiquePublique,
  chargerBoutiques,
} from "../../lib/catalogue.ts";
import { botDisponible, lienCommanderAuBot } from "../../lib/entree-bot.ts";

/**
 * La fiche article.
 *
 * C'est la seule page de la boutique qui porte du JavaScript, et seulement pour
 * le compteur de quantite et le selecteur de variante — l'ilot `Commander`, monte
 * en `client:visible`.
 *
 * **Un lien WhatsApp complet est rendu en HTML avant toute hydratation.** Si le
 * JavaScript n'arrive jamais, l'acheteuse commande quand meme, pour une quantite
 * de un. L'ilot le remplace quand il se monte. C'est ce qui distingue un confort
 * d'une dependance.
 */
export function getStaticPaths() {
  const boutiques = chargerBoutiques();
  return boutiques.flatMap((b) =>
    b.articles.map((a) => ({
      params: { slug: b.slug, produit: a.slug },
      props: { boutique: b, article: a },
    })),
  );
}

interface Props {
  boutique: BoutiquePublique;
  article: ArticlePublic;
}
const { boutique, article } = Astro.props;
/* En congés, le seul lien utile est la conversation nue — pas un message de
   commande pré-rempli pour une commande qui ne sera pas prise (ADR 0039). */
const lienVendeuse = `https://wa.me/${boutique.whatsapp.replace(/\D/g, "")}`;
/**
 * DEUX boutons, et c'est le rang 0 de l'ADR 0061.
 *
 * « Commander » depose dans le fil du BOT, sur cette boutique et cet article :
 * la commande nait dans le moteur, avec sa rampe, sa preuve et son recu.
 * « Parler a la vendeuse » garde le lien humain — l'invariant produit.
 *
 * Sans `PUBLIC_BOT_WHATSAPP`, la page reste EXACTEMENT celle d'avant : un
 * bouton vers `wa.me/` sans numero ouvrirait WhatsApp sur rien.
 */
const versLeBot = botDisponible();
const lienBot = versLeBot
  ? lienCommanderAuBot(boutique.whatsapp, boutique.slug, article.slug)
  : null;
---
<Base
  title={`${article.nom} — ${boutique.nom}`}
  description={`${article.nom} chez ${boutique.nom}, ${boutique.ville}.`}
>
  <main class="mx-auto flex w-full max-w-[34rem] flex-col gap-4 px-4 py-6">
    <nav class="text-caption">
      <a href={`/${boutique.slug}`} class="text-brand-500">← {boutique.nom}</a>
    </nav>

    <PhotoArticle image={article.image} alt={article.nom} prioritaire class="rounded-card" />

    <h1 class="text-title font-bold leading-tight text-ink">{article.nom}</h1>
    <Prix xaf={article.prixXaf} taille="grand" />

    <section class="rounded-card border border-line bg-surface p-4">
      {/* Pas de bloc `<noscript>` ici, et c'est volontaire : Astro rend l'ilot
          COTE SERVEUR avant de l'hydrater, donc le HTML livre contient deja un
          lien WhatsApp complet pour une quantite de un. Un `<noscript>` en
          doublerait le bouton. C'est ce qui rend le compteur un confort et non le
          porteur de la fonction — une acheteuse dont le JavaScript n'arrive
          jamais commande quand meme. */}
      {
        /* Mode congés — ADR 0039. L'îlot n'est pas monté du tout : un compteur
           de quantité au-dessus d'un bouton qui ne commande rien est une
           promesse qu'on ne tient pas. La conversation, elle, reste ouverte —
           c'est même le seul geste utile ici. */
        boutique.enConges ? (
          <div class="flex flex-col gap-3">
            <p role="status" class="text-body text-warn">
              🌴 {boutique.nom} ne prend pas de nouvelle commande en ce moment.
            </p>
            <p class="text-caption text-ink-2">
              Écrivez-lui : elle seule sait quand elle reprend.
            </p>
            <a
              href={lienVendeuse}
              rel="noopener"
              data-testid="ecrire-vendeuse"
              class="inline-flex min-h-[var(--size-touch)] items-center justify-center rounded-field border border-control-line bg-surface px-5 py-3 text-body font-semibold text-ink"
            >
              Écrire à la vendeuse
            </a>
          </div>
        ) : versLeBot && lienBot ? (
          <div class="flex flex-col gap-3">
            <a
              href={lienBot}
              rel="noopener"
              data-testid="commander"
              class="inline-flex min-h-[var(--size-touch)] items-center justify-center rounded-field bg-brand-500 px-5 py-3 text-body font-semibold text-on-brand"
            >
              Commander sur WhatsApp
            </a>
            <a
              href={lienVendeuse}
              rel="noopener"
              data-testid="ecrire-vendeuse"
              class="inline-flex min-h-[var(--size-touch)] items-center justify-center rounded-field border border-control-line bg-surface px-5 py-3 text-body font-semibold text-ink"
            >
              Parler à la vendeuse
            </a>
          </div>
        ) : (
          <Commander
            client:visible
            boutique={boutique.nom}
            whatsapp={boutique.whatsapp}
            nom={article.nom}
            prixXaf={article.prixXaf}
            stock={article.stock}
            variantes={article.variantes}
          />
        )
      }
    </section>

    <section class="flex flex-col gap-2 rounded-card border border-line bg-surface p-4">
      <h2 class="text-body font-semibold text-ink">{boutique.nom}</h2>
      <BadgeVerifie verifiee={boutique.verifiee} />
      <p class="text-caption text-ink-2">
        {[boutique.quartier, boutique.ville].filter(Boolean).join(", ")}
      </p>
      <p class="text-caption text-muted">
        {versLeBot
          ? "« Commander » ouvre WhatsApp sur cet article : vous choisissez la quantité, la livraison, et vous recevez un reçu vérifiable. « Parler à la vendeuse » va directement à elle."
          : "Le message WhatsApp est déjà rempli : article, quantité, prix unitaire, total et nom de la boutique. Vous pouvez le relire avant de l'envoyer."}
      </p>
    </section>
  </main>
</Base>
