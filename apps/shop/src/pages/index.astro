---
import Base from "../layouts/Base.astro";
import { chargerBoutiques } from "../lib/catalogue.ts";

/**
 * La racine du domaine public.
 *
 * Ce n'est PAS un annuaire de boutiques et ce n'en sera pas un : une acheteuse
 * arrive toujours par un lien que la vendeuse lui a envoye sur WhatsApp, jamais
 * par une recherche ici. Publier la liste des vendeuses ferait de Catalog une
 * place de marche, ce qu'il n'est pas — et exposerait qui vend quoi, ce que
 * personne n'a demande.
 *
 * La page dit donc ce qu'est Catalog, en texte, sans JavaScript.
 */
const nombre = chargerBoutiques().length;
---
<Base
  title="Catalog — le catalogue et la preuve de paiement"
  description="Catalog outille les vendeuses camerounaises qui vendent déjà sur WhatsApp : un catalogue partageable, et un reçu de paiement vérifiable."
>
  <main class="mx-auto flex w-full max-w-[34rem] flex-col gap-4 px-4 py-10">
    <h1 class="text-hero font-extrabold leading-tight text-ink">Catalog</h1>
    <p class="text-body text-ink-2">
      Catalog outille les vendeuses camerounaises qui vendent déjà sur WhatsApp.
      La conversation ne bouge pas : on ajoute par-dessus un catalogue
      partageable, une rampe de paiement mobile money, et un reçu que l'acheteuse
      peut vérifier.
    </p>
    <p class="text-body text-ink-2">
      Les fonds ne passent jamais par un compte de Catalog. Ils vont du
      portefeuille de l'acheteuse à celui de la vendeuse, directement.
    </p>
    <p class="text-caption text-muted">
      Chaque boutique a son propre lien, que la vendeuse partage elle-même. Il n'y
      a pas d'annuaire ici : ce n'est pas une place de marché.
      {nombre > 0 ? ` (${nombre} boutique${nombre > 1 ? "s" : ""} en ligne.)` : ""}
    </p>
  </main>
</Base>
