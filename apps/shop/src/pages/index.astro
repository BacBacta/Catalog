---
import Base from "../layouts/Base.astro";
import { chargerBoutiques } from "../lib/catalogue.ts";
import { EDITEUR } from "../lib/editeur.ts";

/**
 * La racine du domaine public — ADR 0041.
 *
 * Ce n'est PAS un annuaire de boutiques et ce n'en sera pas un : une acheteuse
 * arrive toujours par un lien que la vendeuse lui a envoye sur WhatsApp, jamais
 * par une recherche ici. Publier la liste des vendeuses ferait de Catalog une
 * place de marche, ce qu'il n'est pas — et exposerait qui vend quoi, ce que
 * personne n'a demande.
 *
 * Elle a un second role depuis le 05/08/2026 : c'est le SITE que 360dialog et
 * Meta ouvrent pour verifier l'entreprise. D'ou l'identite legale en pied de
 * page et le lien de confidentialite — un verificateur qui doit deviner une
 * URL conclut qu'elle n'existe pas.
 *
 * **Zero JavaScript**, comme le reste de la boutique publique. Ce qui est
 * ecrit ici tient dans le budget (AGENTS.md).
 */
const nombre = chargerBoutiques().length;

/** Ce que fait le produit, dit une fois. */
const PILIERS = [
  {
    titre: "Un catalogue partageable",
    corps:
      "Vos articles, avec photo et prix, dans un lien que vous envoyez vous-même. Vos clientes commandent sans quitter WhatsApp.",
  },
  {
    titre: "Le paiement, pré-rempli",
    corps:
      "Le clavier de l'acheteuse s'ouvre garni : le code de votre opérateur, votre numéro, le montant. Elle n'a plus qu'à appeler.",
  },
  {
    titre: "Un reçu vérifiable",
    corps:
      "Chaque paiement prouvé donne un reçu que l'acheteuse peut vérifier, avec l'identifiant de transaction de l'opérateur.",
  },
] as const;
---
<Base
  title={`${EDITEUR.produit} — le catalogue et la preuve de paiement`}
  description="Catalog outille les vendeuses camerounaises qui vendent déjà sur WhatsApp : un catalogue partageable, une rampe de paiement mobile money, et un reçu que l'acheteuse peut vérifier."
>
  <main class="mx-auto flex w-full max-w-[46rem] flex-col gap-10 px-4 py-10">
    <header class="flex flex-col gap-3">
      <h1 class="text-hero font-extrabold leading-tight text-ink">{EDITEUR.produit}</h1>
      <p class="text-title font-semibold text-ink-2">
        Vendez sur WhatsApp comme aujourd'hui. Avec une preuve de paiement en plus.
      </p>
      <p class="text-body text-ink-2">
        {EDITEUR.produit} outille les vendeuses camerounaises qui vendent <strong class="text-ink"
          >déjà</strong
        > sur WhatsApp. La conversation ne bouge pas : on ajoute par-dessus un catalogue partageable,
        une rampe de paiement mobile money, un suivi de commande et une réputation vérifiée.
      </p>
    </header>

    <section class="flex flex-col gap-3">
      {
        PILIERS.map((p) => (
          <article class="rounded-card border border-line bg-surface p-4">
            <h2 class="text-body font-bold text-ink">{p.titre}</h2>
            <p class="mt-1 text-body text-ink-2">{p.corps}</p>
          </article>
        ))
      }
    </section>

    <section class="flex flex-col gap-3">
      <h2 class="text-title font-bold text-ink">La capture d'écran ne prouve rien</h2>
      <p class="text-body text-ink-2">
        L'arnaque la plus courante du marché est la fausse capture Mobile Money : un acheteur
        montre une image, la marchandise part, l'argent n'arrive jamais. Une capture ne porte
        aucun identifiant contrôlable — <strong class="text-ink"
          >Catalog n'en accepte aucune comme preuve</strong
        >.
      </p>
      <p class="text-body text-ink-2">
        Ce qui fait foi, c'est <strong class="text-ink">le SMS que votre opérateur vous a
        envoyé, à vous</strong>. Vous le collez, Catalog l'analyse et lui applique sept contrôles :
        format de l'opérateur, montant, contrepartie, horodatage, unicité de l'identifiant de
        transaction sur tout le réseau, cohérence interne, et contre-signature de l'acheteuse.
      </p>
      <p class="text-body text-ink-2">
        La personne qui apporte la preuve est celle dont l'argent est en jeu. C'est ce qui fait
        disparaître la fraude, structurellement.
      </p>
    </section>

    <section class="flex flex-col gap-3">
      <h2 class="text-title font-bold text-ink">Votre argent ne passe pas par nous</h2>
      <p class="text-body text-ink-2">
        Les fonds vont du portefeuille de l'acheteuse au vôtre, <strong class="text-ink"
          >directement</strong
        >. {EDITEUR.produit} n'initie rien, ne détient rien, n'encaisse rien — et ne peut donc
        prélever aucune commission.
      </p>
      <p class="text-body text-ink-2">
        Vous encaissez sur le portefeuille mobile de votre choix, celui que vous avez déjà. Aucun
        compte à ouvrir. Le revenu du service vient de l'abonnement, pas de vos ventes :
        <strong class="text-ink">0 % de commission</strong>.
      </p>
      <p class="text-body text-ink-2">
        Votre code secret Mobile Money se saisit dans la session de votre opérateur.
        {EDITEUR.produit} ne le voit jamais, ne le demande jamais, et n'a aucun champ où il
        pourrait être écrit.
      </p>
    </section>

    <section class="flex flex-col gap-3">
      <h2 class="text-title font-bold text-ink">Vous ouvrez votre boutique sur WhatsApp</h2>
      <ol class="flex list-decimal flex-col gap-2 pl-5 text-body text-ink-2">
        <li>Vous écrivez au numéro {EDITEUR.produit} et demandez à vendre.</li>
        <li>Vous donnez le nom de votre boutique et votre ville — deux minutes.</li>
        <li>
          Vous envoyez la photo d'un article, avec son nom et son prix en légende. Il est en ligne.
        </li>
        <li>Vous partagez votre lien, ou l'image de vitrine que le bot vous prépare pour le Statut.</li>
      </ol>
      <p class="text-caption text-muted">
        Tout se fait dans la conversation. L'espace vendeuse existe pour vos chiffres et votre
        numéro de reversement, mais rien ne vous oblige à y aller pour vendre.
      </p>
    </section>

    <section class="flex flex-col gap-2">
      <h2 class="text-title font-bold text-ink">Vous avez reçu un lien de boutique ?</h2>
      <p class="text-body text-ink-2">
        Ouvrez-le : vous verrez les articles, vous commanderez, et vous discuterez avec la vendeuse
        sur son WhatsApp comme d'habitude. Si elle prouve votre paiement, vous recevez un reçu
        vérifiable — et vous pouvez confirmer que le paiement vient bien de vous.
      </p>
      <p class="text-caption text-muted">
        Chaque boutique a son propre lien, que la vendeuse partage elle-même. Il n'y a pas
        d'annuaire ici : ce n'est pas une place de marché.
        {nombre > 0 ? ` (${nombre} boutique${nombre > 1 ? "s" : ""} en ligne.)` : ""}
      </p>
    </section>

    {/* L'identite legale et la confidentialite : ce qu'un verificateur cherche
        en premier, et ce qu'une utilisatrice doit trouver sans demander. */}
    <footer class="flex flex-col gap-2 border-t border-line pt-5">
      <p class="text-caption text-muted">
        <a href="/confidentialite" class="text-brand-500">Confidentialité</a>
      </p>
      <p class="text-caption text-muted">
        {EDITEUR.produit} est édité par <strong class="text-ink-2">{EDITEUR.societe}</strong>,
        {EDITEUR.forme} au capital de {EDITEUR.capitalXaf.toLocaleString("fr-FR")} FCFA.<br />
        RCCM {EDITEUR.rccm} — Siège : {EDITEUR.siege}.<br />
        Gérant : {EDITEUR.gerant}.
      </p>
      <p class="text-caption text-muted">
        Contact : <a href={`mailto:${EDITEUR.contact}`} class="text-brand-500">{EDITEUR.contact}</a>
      </p>
    </footer>
  </main>
</Base>
