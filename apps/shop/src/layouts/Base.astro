---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  /** Pages qui n'ont aucun sens sans parametres — la rampe de paiement. */
  noindex?: boolean;
}
const { title, description = "Boutique sur Catalog", noindex = false } = Astro.props;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <!-- Aucune police telechargee : la pile systeme coute zero octet. -->
  </head>
  <body>
    <slot />
  </body>
</html>
