---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}
const { title, description = "Boutique sur Swap" } = Astro.props;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Aucune police telechargee : la pile systeme coute zero octet. -->
  </head>
  <body>
    <slot />
  </body>
</html>
