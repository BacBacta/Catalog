{
  "name": "@catalog/shop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --port 4321",
    "build": "astro build && node scripts/entetes.mjs",
    "preview": "astro preview",
    "test": "TZ=Africa/Douala vitest run",
    "typecheck": "astro check --minimumFailingSeverity error",
    "size": "node scripts/budget.mjs",
    "snapshot": "node ../api/scripts/exporter-catalogue.mjs src/data/catalogue.json",
    "lighthouse": "CHROME_PATH=./scripts/chrome-lighthouse.sh lhci autorun"
  },
  "dependencies": {
    "@astrojs/preact": "6.0.2",
    "@catalog/contracts": "workspace:*",
    "@catalog/ui": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.2.0",
    "preact": "10.29.8",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@lhci/cli": "0.15.1",
    "@types/node": "26.2.0",
    "preact-render-to-string": "6.7.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
