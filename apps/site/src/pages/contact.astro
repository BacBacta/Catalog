---
import { EDITEUR } from "@catalog/contracts/editeur";
import Base from "../layouts/Base.astro";

/**
 * Les coordonnees — ADR 0042.
 *
 * **Aucun formulaire.** Un formulaire de contact suppose un point de reception,
 * un stockage des messages et une politique pour eux ; une adresse de courriel
 * ne suppose rien et arrive au meme endroit. C'est aussi ce qu'un verificateur
 * peut EPROUVER : il ecrit, on repond.
 */
---
<Base
  chemin="/contact"
  title={`Contact — ${EDITEUR.societe}`}
  description="Coordonnées d'Horizon Services, éditeur de Catalog : adresse de contact, siège social et identité légale."
>
  <section class="banniere">
    <div class="enveloppe flex flex-col gap-5 pt-12 pb-14">
      <p class="surtitre">Contact</p>
      <h1 class="titre-geant">Nous écrire</h1>
      <p class="chapeau">
        Une seule adresse, pour tout : une question sur nos services, une demande d'accès ou de
        suppression de données, une boutique à ouvrir. Une personne vous répond.
      </p>
      <div class="flex flex-wrap gap-3 pt-1">
        <a href={`mailto:${EDITEUR.contact}`} class="bouton bouton--plein">{EDITEUR.contact}</a>
      </div>
    </div>
  </section>

  <section class="enveloppe section flex flex-col gap-5">
    <div class="flex flex-col gap-3">
      <p class="numero-section">MENTIONS LÉGALES</p>
      <h2 class="titre-section">L'entreprise</h2>
    </div>
    <dl class="carte grid gap-4 sm:grid-cols-2">
      <div>
        <dt class="fait__libelle">Dénomination</dt>
        <dd class="m-0 fait__valeur">{EDITEUR.societe}</dd>
      </div>
      <div>
        <dt class="fait__libelle">Forme juridique</dt>
        <dd class="m-0 text-ink">{EDITEUR.forme}</dd>
      </div>
      <div>
        <dt class="fait__libelle">Capital social</dt>
        <dd class="m-0 text-ink">{EDITEUR.capitalXaf.toLocaleString("fr-FR")} FCFA</dd>
      </div>
      <div>
        <dt class="fait__libelle">RCCM</dt>
        <dd class="m-0 text-ink">{EDITEUR.rccm}</dd>
      </div>
      <div>
        <dt class="fait__libelle">Siège social</dt>
        <dd class="m-0 text-ink">{EDITEUR.siege}</dd>
      </div>
      <div>
        <dt class="fait__libelle">Gérant</dt>
        <dd class="m-0 text-ink">{EDITEUR.gerant}</dd>
      </div>
      <div>
        <dt class="fait__libelle">Produit édité</dt>
        <dd class="m-0 text-ink">{EDITEUR.produit}</dd>
      </div>
    </dl>
    <p class="m-0 text-caption text-muted">
      Il n'existe pas d'adresse postale de rue au Cameroun : la boîte postale est l'adresse
      officielle, celle qui figure au registre du commerce.
    </p>
  </section>
</Base>
