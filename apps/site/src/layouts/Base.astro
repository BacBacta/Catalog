---
import { EDITEUR } from "@catalog/contracts/editeur";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** Chemin de la page, pour l'URL canonique et l'etat de navigation. */
  chemin: string;
}
const { title, description, chemin } = Astro.props;
const canonique = new URL(chemin, EDITEUR.site).href;

/**
 * La coquille du site de la SOCIETE — ADR 0042, revise le 05/08/2026.
 *
 * Le site parle d'Horizon Services, pas de Catalog : Catalog est un PRODUIT de
 * la maison, presente comme tel. Une societe qui se confond avec son premier
 * produit n'a rien a montrer le jour ou elle en a deux — et un verificateur
 * qui cherche l'entreprise derriere le numero WhatsApp doit la trouver, elle.
 *
 * **Aucune police telechargee, aucun JavaScript, aucun traceur.** Ce n'est pas
 * de l'ascetisme : la page qui explique qu'on ne vend aucune donnee ne va pas
 * charger un mouchard pour compter ses visites. La CSP l'interdit
 * materiellement (`default-src 'none'`).
 *
 * L'URL canonique est ABSOLUE et pointe l'apex. Le domaine repond aussi en
 * `www` : sans canonique, les deux formes seraient deux pages differentes pour
 * un moteur — et pour un verificateur qui compare l'URL declaree a celle qu'il
 * atteint.
 */
const NAV = [
  { href: "/", texte: "La société" },
  { href: "/#catalog", texte: "Catalog" },
  { href: "/confidentialite", texte: "Confidentialité" },
  { href: "/contact", texte: "Contact" },
] as const;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonique} />
    <meta property="og:site_name" content={EDITEUR.societe} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta name="theme-color" content="#0e7a5f" />
  </head>
  <body>
    <header class="entete">
      <div class="enveloppe flex flex-wrap items-center justify-between gap-x-6 gap-y-2 py-3.5">
        <a href="/" class="marque">
          <span>{EDITEUR.societe}</span>
          <span class="marque__point" aria-hidden="true"></span>
        </a>
        <nav aria-label="Principale" class="flex flex-wrap items-center gap-x-5 gap-y-1">
          {
            NAV.map((l) => (
              <a
                href={l.href}
                class="lien-nav"
                aria-current={chemin === l.href ? "page" : undefined}
              >
                {l.texte}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <slot />

    <footer class="pied">
      <div class="enveloppe flex flex-col gap-5 py-9">
        <div class="flex flex-wrap justify-between gap-6">
          <div class="flex max-w-sm flex-col gap-1.5">
            <span class="marque">{EDITEUR.societe}</span>
            <p class="m-0">
              Société de services immatriculée à Douala. Nous concevons et exploitons{" "}
              <a href="/#catalog">{EDITEUR.produit}</a>.
            </p>
          </div>
          <nav aria-label="Pied de page" class="flex flex-col gap-1.5">
            <a href="/">La société</a>
            <a href="/confidentialite">Confidentialité</a>
            <a href="/contact">Contact</a>
            <a href={`mailto:${EDITEUR.contact}`}>{EDITEUR.contact}</a>
          </nav>
        </div>

        <hr class="filet" />

        <p class="m-0">
          <strong>{EDITEUR.societe}</strong> — {EDITEUR.forme} au capital de{" "}
          {EDITEUR.capitalXaf.toLocaleString("fr-FR")} FCFA.<br />
          RCCM {EDITEUR.rccm} — Siège : {EDITEUR.siege}. Gérant : {EDITEUR.gerant}.<br />
          © 2019–2026 {EDITEUR.societe}. Tous droits réservés.
        </p>
      </div>
    </footer>
  </body>
</html>
